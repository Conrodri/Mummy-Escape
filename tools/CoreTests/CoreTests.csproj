<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast, Unity-free test harness: compiles the exact same Core + EditMode test sources as Unity. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>CoreTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../MummyEscape/Assets/_Project/Scripts/Core/**/*.cs" Exclude="../../MummyEscape/Assets/_Project/Scripts/Core/AssemblyInfo.cs" LinkBase="Core" />
    <Compile Include="../../MummyEscape/Assets/_Project/Scripts/Pvp/**/*.cs" LinkBase="Pvp" />
    <Compile Include="../../MummyEscape/Assets/_Project/Tests/EditMode/**/*.cs" LinkBase="Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
