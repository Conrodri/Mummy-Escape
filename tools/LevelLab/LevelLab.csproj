<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console report: generates every level and prints the difficulty table actually produced. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../MummyEscape/Assets/_Project/Scripts/Core/**/*.cs" Exclude="../../MummyEscape/Assets/_Project/Scripts/Core/AssemblyInfo.cs" LinkBase="Core" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
